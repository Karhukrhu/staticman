   {
     "version": 2,
     "builds": [
       {
         "src": "api/index.js",
         "use": "@vercel/node"
       }
     ],
     "routes": [
       {
         "src": "/v2/(.*)",
         "dest": "api/index.js"
       },
       {
         "src": "/v3/(.*)",
         "dest": "api/index.js"
       }
     ]
   }
